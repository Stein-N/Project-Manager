<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectManager.ViewModels"
        xmlns:m="using:ProjectManager.Models"
        x:Class="ProjectManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MC Mod Project Manager (C# example)"
        Icon="/Assets/icon.png"
        Width="900" Height="600" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterScreen">

  <DockPanel>
    <!-- toolbar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
            BorderThickness="0,0,0,1" Padding="10,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Rescan" Command="{Binding RescanCommand}"
                IsEnabled="{Binding !Busy}" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Master folder" Classes="label" />
          <TextBlock Text="{Binding Master}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
            BorderThickness="0,1,0,0" Padding="10,3">
      <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" />
    </Border>

    <Grid ColumnDefinitions="300,4,*">
      <!-- versions → projects -->
      <TreeView ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}"
                Background="{StaticResource Panel}">
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="m:McVersion" ItemsSource="{Binding Projects}">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          </TreeDataTemplate>
          <DataTemplate DataType="m:Project">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Name}" />
              <TextBlock Text="{Binding State}" Classes="muted" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>

      <GridSplitter Grid.Column="1" Background="{StaticResource Border}" ResizeDirection="Columns" />

      <!-- details -->
      <Panel Grid.Column="2" Margin="18,14">
        <TextBlock Text="Select a project." Classes="muted" IsVisible="{Binding !HasProject}" />
        <StackPanel Spacing="12" IsVisible="{Binding HasProject}">
          <TextBlock Text="{Binding Project.Name, FallbackValue=''}" FontSize="18" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Classes="facts">
            <Grid.Styles>
              <Style Selector="Grid.facts > TextBlock">
                <Setter Property="Margin" Value="0,0,16,6" />
              </Style>
            </Grid.Styles>
            <TextBlock Text="Minecraft" Classes="label" />
            <TextBlock Grid.Column="1" Text="{Binding Project.McVersion, FallbackValue=''}" />
            <TextBlock Grid.Row="1" Text="Folder" Classes="label" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Project.Path, FallbackValue=''}"
                                 TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Text="Git" Classes="label" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Project.State, FallbackValue=''}" />
            <TextBlock Grid.Row="3" Text="Changes" Classes="label" />
            <TextBlock Grid.Row="3" Grid.Column="1"
                       Text="{Binding Project.Changes, FallbackValue=0, StringFormat='{}{0} files'}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
            <Button Content="Open terminal" Command="{Binding OpenTerminalCommand}" />
          </StackPanel>
        </StackPanel>
      </Panel>
    </Grid>
  </DockPanel>
</Window>
